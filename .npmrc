# React Native / Expo native (iOS/Android) builds assume a flat node_modules.
# pnpm's default symlinked .pnpm layout breaks C++ header search paths (e.g.
# ExpoModulesJSI failing to find <hermes/hermes.h>). Hoisting fixes the native build.
# Node-side tooling (tsx e2e tests, drizzle) works under either layout.
node-linker=hoisted
